# Copy to .env (gitignored) and fill in as keys arrive. See SETUP.md.
# Values marked SECRET must be added by hand — never commit them, never paste in chat.
#
# ⚠ DO NOT put a trailing `# comment` on a line holding a key or secret. Node's --env-file strips
#   them, but many hand-rolled .env readers do not, and the comment ends up INSIDE the value — which
#   surfaces as a baffling `401 invalid_secret_key` on a key you copied correctly. Comments here sit
#   on their own lines for exactly that reason.

# ---- payments (app-services) ----
# stub = full demo with no Unifold key; unifold = real gateway (SWAP B)
PAYMENT_GATEWAY=stub
UNIFOLD_API_BASE=https://api.unifold.io/v1
# LIVE keys, not test. Unifold has no usable testnet — their guidance is mainnet with small
# amounts, and Checkout/Payment Intents are mainnet-only. Keep Test Mode OFF in the dashboard.
# pk_ is safe in the browser; sk_ is SECRET and server-side only.
UNIFOLD_PUBLISHABLE_KEY=pk_live_
UNIFOLD_SECRET_KEY=sk_live_
# From POST /v1/treasury/accounts { chain_type: "ethereum" } — that covers Base; there is no
# separate "base" chain_type. Run: node scripts/unifold-setup.mjs --webhook-url https://<host>
UNIFOLD_TREASURY_ID=ta_
# SECRET. Re-readable any time via scripts/unifold-webhook-secret.mjs.
UNIFOLD_WEBHOOK_SECRET=whsec_
# Base address BUY proceeds settle to (v1 payment intents deliver Base USDC ONLY). Setting this to
# the treasury's OWN address makes the demo self-funding: buys pay into the same account that
# sell-backs pay out of. Required when PAYMENT_GATEWAY=unifold.
UNIFOLD_BASE_RECIPIENT_ADDRESS=0x
# USDC contract on Base, used as token_address on payouts. Default is canonical Base USDC.
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Diner Base (0x…) payout address. Placeholder until Auth0 + the wallet registry land. Unset means
# every sell-back fails, because the payout falls back to using the user id as an address.
DEMO_DINER_BASE_ADDRESS=
# Divides every pool's p0 and k. 1 = full demo pricing ($58 a buy) — fine on the stub, expensive on
# the live gateway. Set 10 for a ~$5.80 buy that still clears Unifold's ~3 USDC L2 minimum.
DEMO_PRICE_DIVISOR=1

# ---- identity (Auth0) ----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.ttr.local      # your Auth0 API identifier
AUTH0_CLIENT_SECRET=                      # SECRET

# ---- chain-services read model ----
DATABASE_URL=postgres://postgres:dev@localhost:5432/ttr

# ---- Solana (chain-services SWAP A only) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json    # keypair path — SECRET (do not commit the keypair)

# ---- local dev ----
APP_SERVICES_PORT=8080

# ---- deployment (app-services; see DEPLOY_CHECKLIST.md) ----
# Public origin app-services is reachable at. Used to build the StubGateway mock deposit
# hosted_url and the webhook URL you register with Unifold. Leaving it localhost in a deployed
# build makes the mock deposit page's "Confirm payment" button dead.
APP_BASE_URL=http://localhost:8080
# Comma-separated origin allowlist for CORS. Unset = `*`, which is fine only while auth is the
# x-user-id stub. Set it to the deployed frontend origins before Auth0 lands.
CORS_ORIGINS=
