# Copy to .env (gitignored) and fill in as keys arrive. See SETUP.md.
# Values marked SECRET must be added by hand — never commit them, never paste in chat.

# ---- payments (app-services) ----
# stub = full demo with no Unifold key; unifold = real gateway (SWAP B)
PAYMENT_GATEWAY=stub
UNIFOLD_API_BASE=https://api.unifold.io/v1
UNIFOLD_PUBLISHABLE_KEY=pk_test_          # safe in browser
UNIFOLD_SECRET_KEY=sk_test_               # SECRET
UNIFOLD_TREASURY_ID=ta_                   # from POST /v1/treasury/accounts { chain_type: solana }
UNIFOLD_WEBHOOK_SECRET=whsec_             # SECRET — from webhook endpoint create / secret endpoint
# Base-chain address BUY proceeds settle to. Unifold v1 payment intents deliver Base USDC ONLY,
# so this is our Base treasury under the treasury-float model (UNIFOLD_INTEGRATION.md §2).
UNIFOLD_BASE_RECIPIENT_ADDRESS=0x        # EVM address — required when PAYMENT_GATEWAY=unifold
# SPL USDC mint used as token_address on Solana payouts (mainnet default shown).
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Diner Solana USDC payout address. Placeholder until Auth0 + the wallet registry land.
DEMO_DINER_SOLANA_ADDRESS=

# ---- identity (Auth0) ----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.ttr.local      # your Auth0 API identifier
AUTH0_CLIENT_SECRET=                      # SECRET

# ---- chain-services read model ----
DATABASE_URL=postgres://postgres:dev@localhost:5432/ttr

# ---- Solana (chain-services SWAP A only) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json    # keypair path — SECRET (do not commit the keypair)

# ---- local dev ----
APP_SERVICES_PORT=8080
