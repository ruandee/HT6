# Launcher targets. Unset = local dev ports, which is what the demo runs on.
# Set these for a deployed build (Vercel: Project → Settings → Environment Variables).
# Vite inlines VITE_* at build time, so changing one needs a redeploy.
VITE_DINER_URL=https://diner.example.com
VITE_MOBILE_URL=https://m.example.com
VITE_RESTAURANT_URL=https://restaurant.example.com
# The full pricing lab, linked from the landing page's decay demo.
VITE_LAB_URL=https://lab.example.com
